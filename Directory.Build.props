<Project>

  <!--
    Repository-wide build settings. Every project under src/ and tests/ inherits these.
    Keep project files (.csproj) minimal: they should only declare references and project-specific overrides.
  -->

  <PropertyGroup Label="Target">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Quality">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <PropertyGroup Label="Reproducibility">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Label="Layout">
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <!--
    Engine version stamp (ADR 0013): the git commit, with a -dirty suffix when the tree has local changes (untracked
    files included, since the compile glob picks up a new source file before it is added), goes
    into the assemblies' informational version as "+<commit>[-dirty]". EngineVersion in Application reads it
    back so every learning artifact names the engine that produced it. Without git the version stays unknown.
    Runs before the SDK appends its own (full, never dirty) revision so the short form always wins.
  -->
  <Target Name="StampEngineVersion" BeforeTargets="AddSourceRevisionToInformationalVersion;GetAssemblyVersion" Condition="'$(EngineVersionFromGit)' != 'false'">
    <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="EngineCommit" />
      <Output TaskParameter="ExitCode" PropertyName="EngineCommitExitCode" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=normal" Condition="'$(EngineCommitExitCode)' == '0'" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="EngineDirtyFiles" />
    </Exec>
    <PropertyGroup Condition="'$(EngineCommitExitCode)' == '0' and '$(EngineCommit)' != ''">
      <EngineDirtySuffix Condition="'$(EngineDirtyFiles)' != ''">-dirty</EngineDirtySuffix>
      <SourceRevisionId>$(EngineCommit)$(EngineDirtySuffix)</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
