{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet --version)",
      "Bash(dotnet --info)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet run --project src/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(npm --prefix battle ci:*)", 
      "Bash(npm --prefix battle run build:*)", 
      "Bash(npm --prefix studio/browser ci:*)", 
      "Bash(node --test:*)", 
      "Bash(npx playwright test:*)", 
      "Bash(uv sync:*)", 
      "Bash(uv run --project learning:*)", 
      "Bash(git fetch:*)", 
      "Bash(git add:*)", 
      "Bash(git commit:*)", 
      "Bash(git merge:*)", 
      "Bash(git push:*)",
      "Bash(scripts/verify.sh:*)",
      "Bash(scripts/gate/state.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets.json)",
      "Edit(./legacy/**)",
      "Write(./legacy/**)",
      "mcp__github__merge_pull_request"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.sh"
          }
        ]
      }
    ]
  }
}
