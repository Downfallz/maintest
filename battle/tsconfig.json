{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "checkJs": false, "noEmit": true,
    "lib": ["ES2022", "DOM"], "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
