# Normalize line endings: LF in the repository, native on checkout is NOT used (LF everywhere).
* text=auto eol=lf

# Scripts must stay LF even on Windows checkouts.
*.sh text eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary

# Make diffs of solution/project files readable and mark generated files.
*.slnx text
*.csproj text
*.props text
*.targets text
