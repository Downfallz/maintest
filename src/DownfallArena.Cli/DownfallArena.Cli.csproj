<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Composition root and console entry point. The only project allowed to reference Infrastructure.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DownfallArena.Application\DownfallArena.Application.csproj" />
    <ProjectReference Include="..\DownfallArena.Infrastructure\DownfallArena.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <!-- The host and the studio are internal to the composition root; its tests exercise them directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DownfallArena.Cli.Tests" />
  </ItemGroup>

</Project>
