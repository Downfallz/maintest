<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The domain layer: aggregates, entities, value objects, domain events, domain services.
    Its only dependency is the SharedKernel. No NuGet packages.
    This constraint is enforced by tests/DownfallArena.Architecture.Tests.
  -->

  <ItemGroup>
    <ProjectReference Include="..\DownfallArena.SharedKernel\DownfallArena.SharedKernel.csproj" />
  </ItemGroup>

  <!-- Entity mutators are internal so that only the aggregate root can reach them; domain tests exercise them directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DownfallArena.Domain.Tests" />
  </ItemGroup>

</Project>
